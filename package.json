{
  "name": "urban-pickle-website",
  "version": "1.0.0",
  "private": true,
  "description": "Urban Pickle marketing site: static HTML built with Eleventy",
  "type": "module",
  "scripts": {
    "start": "eleventy --serve",
    "build": "eleventy",
    "clean": "rm -rf dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:css": "stylelint \"src/assets/css/**/*.css\"",
    "lint:html": "htmlhint \"dist/**/*.html\"",
    "lint": "npm run format:check && npm run lint:css && npm run build && npm run lint:html"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "htmlhint": "^1.9.2",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0"
  }
}
