<!DOCTYPE html>
<html lang="en" style="--header-height: {{ headerHeight or 77 }}px;">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#ffffff">
  <meta name="description" content="{{ description | safe }}">
  <title>{{ title | safe }}</title>
  <link rel="preload" href="assets/fonts/playfair-display-regular.woff2" as="font" type="font/woff2" crossorigin="">
  <link rel="preload" href="assets/fonts/work-sans-medium.woff2" as="font" type="font/woff2" crossorigin="">
  <link rel="icon" href="assets/favicon.svg">
  <link rel="stylesheet" href="assets/css/site.css">
  <!-- Fonts: SIL Open Font License 1.1, see assets/fonts/*-OFL.txt -->
</head>
<body data-brand="1" data-compare="false"{% if bodyClass %} class="{{ bodyClass }}"{% endif %} data-page="{{ pageId }}">
  <script src="assets/js/brand-query.js"></script>
  <a class="skip" href="#main">Skip to content</a>
  {% include "partials/header.njk" %}
  <main id="main" tabindex="-1">{{ content | safe }}</main>
  {% include "partials/footer.njk" %}
  <script src="assets/js/site.js"></script>
  <script src="assets/js/motion.js"></script>
  <script src="assets/js/brand-options.js"></script>
  {%- if courtScene %}
  <script src="assets/js/court-scene.js"></script>
  <script src="assets/js/court-scene-config.js"></script>
  <script src="assets/js/home-cinema.js"></script>
  {%- endif %}
</body>
</html>
