  <header class="site-header">
    <div class="container header-inner">
      {% include "partials/logo.njk" %}
      <nav class="desktop-nav" aria-label="Main navigation">
        {%- for item in site.mainNav | rejectattr("footerOnly") -%}
          <a href="{{ item.href or item.id }}"{% if item.id == pageId %} aria-current="page"{% endif %}>{{ item.label }}</a>
        {%- endfor -%}
      </nav>
      <div class="header-actions"><a class="btn" href="{{ business.bookingUrl | escape }}" target="_blank" rel="noopener noreferrer">Book a court <span class="arrow" aria-hidden="true">↗</span></a><button class="menu-button" type="button" id="menu-toggle" aria-expanded="false" aria-controls="mobile-nav">Menu <svg width="20" height="18" viewbox="0 0 20 18" fill="none" aria-hidden="true"><path d="M1 4h18M1 13h18" stroke="currentColor" stroke-width="1.5"></path></svg></button></div>
    </div>
    <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation" hidden="">
      {%- for item in site.mainNav | rejectattr("footerOnly") -%}
        <a href="{{ item.href or item.id }}">{{ item.label }}</a>
      {%- endfor -%}
      <a class="btn" href="{{ business.bookingUrl | escape }}" target="_blank" rel="noopener noreferrer">Book a court <span class="arrow" aria-hidden="true">↗</span></a></nav>
  </header>
