<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        {% include "partials/logo.njk" %}
        <p>{{ business.address.street }}, {{ business.address.area }}, {{ business.address.cityShort }}.<br>{{ business.hoursLine }}.<br><a href="{{ business.phoneHref }}">{{ business.phone }}</a></p>
      </div>
      <div class="footer-column">
        <h3>Explore</h3>
        {%- for item in site.mainNav -%}
          <a href="{{ item.id }}">{{ item.label }}</a>
        {%- endfor -%}
      </div>
      <div class="footer-column">
        <h3>Book &amp; contact</h3>
        <a href="{{ business.bookingUrl | escape }}" target="_blank" rel="noopener noreferrer">Book a court</a>
        <a href="{{ business.whatsappUrl }}" target="_blank" rel="noopener noreferrer">WhatsApp us</a>
        <a href="{{ business.whatsappCommunityUrl }}" target="_blank" rel="noopener noreferrer">Community chat</a>
        <a href="{{ business.instagram }}" target="_blank" rel="noopener noreferrer">Instagram</a>
        <a href="{{ business.mapsDirectionsUrl | escape }}" target="_blank" rel="noopener noreferrer">Get directions</a>
      </div>
    </div>
    <div class="footer-word" aria-hidden="true">SEE YOU ON COURT.</div>
    <div class="footer-bottom">
      <span>© <span id="year">2026</span> {{ business.name }} · {{ business.legalName }}</span>
      <a href="help#privacy">Privacy</a>
    </div>
  </div>
</footer>
<div class="mobile-book"><span>Your next good game.</span><a class="btn" href="{{ business.bookingUrl | escape }}" target="_blank" rel="noopener noreferrer">Book a court <span class="arrow" aria-hidden="true">↗</span></a></div>
<noscript><div class="container page-body"><h1>{{ business.name }}</h1><p>Covered and open-air courts on {{ business.address.street }}.<br>{{ business.hoursLine }}.</p><a class="btn" href="{{ business.bookingUrl | escape }}" target="_blank" rel="noopener noreferrer">Book on Courtsite ↗</a></div></noscript>
